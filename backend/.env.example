DB_URL=jdbc:postgresql://host:port/database?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=changeme
SERVER_PORT=8080

# ML / ONNX
TECHMIND_ML_FALLBACK_ENABLED=true

# OCI Language (traducción EN -> ES). Dejar enabled=false en local sin credenciales.
TECHMIND_OCI_LANGUAGE_ENABLED=false
TECHMIND_OCI_COMPARTMENT_ID=
TECHMIND_OCI_CONFIG_FILE=~/.oci/config
TECHMIND_OCI_PROFILE=DEFAULT

# CORS (frontend)
TECHMIND_CORS_ALLOWED_ORIGINS=http://localhost:4321
